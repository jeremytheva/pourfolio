{
  "contract_name": "pourfolio-data-contract",
  "contract_version": "1.6.0",
  "authority": {
    "repository": "jeremytheva/pourfolio",
    "classification_document": "docs/nocodebackend/launch-schema-contract.md",
    "detailed_mapping_document": "docs/nocodebackend/schema-mapping.md",
    "consumer_repositories": [
      "jeremytheva/pourfolio-feeder"
    ],
    "compatibility_rule": "Consumers must reject unsupported major versions and fail closed before mutation when a required collection or field is not authorised by this contract."
  },
  "evidence": {
    "provider_instance": "54026_rating",
    "basis": "repository-supplied provider export, governed owner-confirmed provider changes, and connected read-only provider verification; current live API rows are authoritative for application field names where they conflict with older exports",
    "live_introspection": true
  },
  "provider": {
    "name": "NoCodeBackend",
    "auth_base_url": "https://app.nocodebackend.com/api/user-auth",
    "data_base_url": "https://api.nocodebackend.com/",
    "canonical_environment_variables": [
      "NOCODEBACKEND_AUTH_BASE_URL",
      "NOCODEBACKEND_DATA_BASE_URL",
      "NOCODEBACKEND_AUTH_SECRET_KEY",
      "NOCODEBACKEND_SECRET_KEY",
      "NOCODEBACKEND_INSTANCE",
      "NOCODEBACKEND_USER_EMAIL",
      "NOCODEBACKEND_USER_SECRET_KEY",
      "NOCODEBACKEND_ADMIN_EMAIL",
      "NOCODEBACKEND_ADMIN_SECRET_KEY"
    ]
  },
  "classification_values": [
    "DEPLOYED_REQUIRED",
    "DEPLOYED_OPTIONAL",
    "DEFERRED_TARGET",
    "UNAVAILABLE"
  ],
  "collections": {
    "products": {
      "classification": "DEPLOYED_REQUIRED",
      "provider_fields": [
        "id",
        "user_id",
        "product_name",
        "product_category_id",
        "producer_id",
        "abv",
        "ibu",
        "declared_category",
        "edition",
        "collaboration",
        "product_image"
      ],
      "required_fields": [
        "id",
        "product_name"
      ],
      "optional_fields": [
        "product_category_id",
        "producer_id",
        "abv",
        "ibu",
        "declared_category",
        "edition",
        "collaboration",
        "product_image"
      ],
      "relationships": {
        "product_category_id": "categories.id",
        "producer_id": "producers.id"
      },
      "semantic_notes": {
        "producer_id": "Transitional compatibility mirror of the primary product_producers relationship. New catalogue reads prefer product_producers and fall back to this field only when no relationship rows exist.",
        "collaboration": "Transitional compatibility field. New catalogue writes derive collaboration state from the number of product_producers relationships."
      }
    },
    "producers": {
      "classification": "DEPLOYED_REQUIRED",
      "provider_fields": [
        "id",
        "user_id",
        "producer_name",
        "address",
        "suburb_id"
      ]
    },
    "product_producers": {
      "classification": "DEPLOYED_REQUIRED",
      "provider_fields": [
        "id",
        "product_id",
        "producer_id",
        "is_primary",
        "sort_order"
      ],
      "required_fields": [
        "id",
        "product_id",
        "producer_id",
        "is_primary",
        "sort_order"
      ],
      "relationships": {
        "product_id": "products.id",
        "producer_id": "producers.id"
      },
      "semantic_notes": {
        "authority": "Authoritative product-to-producer relationship collection for both single-producer and collaborative products.",
        "is_primary": "Exactly one relationship should be primary for a product under the application write contract.",
        "sort_order": "Stable producer display order; primary producer is written at sort_order 1."
      }
    },
    "categories": {
      "classification": "DEPLOYED_REQUIRED",
      "provider_fields": [
        "id",
        "user_id",
        "category_name",
        "parent_id"
      ]
    },
    "rating_attributes": {
      "classification": "DEPLOYED_REQUIRED",
      "provider_fields": [
        "id",
        "user_id",
        "category_id",
        "attribute_name",
        "is_scored",
        "weighting"
      ]
    },
    "bonus_attributes": {
      "classification": "DEPLOYED_OPTIONAL",
      "provider_fields": [
        "id",
        "user_id",
        "description",
        "point_value"
      ]
    },
    "ratings": {
      "classification": "DEPLOYED_REQUIRED",
      "provider_fields": [
        "id",
        "user_id",
        "rating_id",
        "product_id",
        "cellar_id",
        "date_rated",
        "total_unweighted",
        "total_weighted"
      ],
      "semantic_notes": {
        "rating_id": "Physical presence does not certify the deferred durable submission-identity semantics documented by the launch contract."
      }
    },
    "rating_scores": {
      "classification": "DEPLOYED_REQUIRED",
      "provider_fields": [
        "id",
        "user_id",
        "attribute_id",
        "rating_id",
        "attribute_score"
      ]
    },
    "bonus_attribute_rating_mapping": {
      "classification": "DEPLOYED_OPTIONAL",
      "provider_fields": [
        "id",
        "user_id",
        "rating_id",
        "bonus_attribute_id"
      ],
      "semantic_notes": {
        "current_provider_field": "Connected read-only verification on 2026-10-04 examined 1,733 live mapping rows; all exposed bonus_attribute_id and none exposed bonus_attributes_id.",
        "historical_export": "The retained 2026-07-14 SQL export records bonus_attributes_id for this table. Treat that spelling as historical evidence, not the current NoCodeBackend API contract."
      }
    },
    "cellar": {
      "classification": "DEPLOYED_REQUIRED",
      "provider_fields": [
        "id",
        "user_id",
        "product_id",
        "location_id",
        "quantity",
        "mls",
        "container",
        "purchase_price",
        "retail_price",
        "date_received",
        "sharing_series_id",
        "series_edition_id",
        "purchase_location_id",
        "purchased_by_id",
        "gift",
        "gift_from",
        "bet_id",
        "notes"
      ]
    },
    "brew_done_it_games": {
      "classification": "DEPLOYED_OPTIONAL",
      "provider_fields": [
        "id",
        "user_id",
        "creator_participant_id",
        "opponent_participant_id",
        "creator_history_clues_enabled",
        "opponent_history_clues_enabled",
        "invitation_digest",
        "status",
        "current_round_number",
        "version",
        "creation_idempotency_key",
        "creation_request_fingerprint",
        "join_idempotency_key",
        "terminal_idempotency_key",
        "created_at",
        "joined_at",
        "last_activity_at",
        "expires_at",
        "archived_at"
      ]
    },
    "brew_done_it_rounds": {
      "classification": "DEPLOYED_OPTIONAL",
      "provider_fields": [
        "id",
        "user_id",
        "game_id",
        "round_number",
        "selector_participant_id",
        "guesser_participant_id",
        "selected_product_id",
        "status",
        "turn_sequence",
        "max_turns",
        "question_count",
        "incorrect_formal_guess_count",
        "incorrect_guess_count",
        "brewery_correct",
        "beer_correct",
        "style_correct",
        "version",
        "pending_action_key",
        "pending_action_type",
        "pending_action_started_at",
        "last_action_key",
        "last_action_type",
        "round_creation_idempotency_key",
        "terminal_idempotency_key",
        "scoring_rules_version",
        "awarded_points",
        "score_breakdown",
        "completion_reason",
        "created_at",
        "started_at",
        "completed_at"
      ],
      "relationships": {
        "game_id": "brew_done_it_games.id",
        "selected_product_id": "products.id"
      }
    },
    "brew_done_it_guesses": {
      "classification": "DEPLOYED_OPTIONAL",
      "provider_fields": [
        "id",
        "user_id",
        "round_id",
        "turn_sequence",
        "guess_type",
        "guessed_product_id",
        "guessed_producer_id",
        "guessed_category_id",
        "guesser_participant_id",
        "is_correct",
        "idempotency_key",
        "action_state",
        "committed_round_version",
        "created_at"
      ],
      "relationships": {
        "round_id": "brew_done_it_rounds.id",
        "guessed_product_id": "products.id",
        "guessed_producer_id": "producers.id",
        "guessed_category_id": "categories.id"
      }
    },
    "brew_done_it_deductions": {
      "classification": "DEPLOYED_OPTIONAL",
      "provider_fields": [
        "id",
        "user_id",
        "round_id",
        "recorded_by_participant_id",
        "dimension",
        "answer",
        "value_text",
        "reference_id",
        "numeric_value",
        "idempotency_key",
        "observed_round_version",
        "action_state",
        "committed_round_version",
        "created_at",
        "updated_at"
      ],
      "relationships": {
        "round_id": "brew_done_it_rounds.id"
      }
    },
    "profiles": {
      "classification": "DEPLOYED_REQUIRED",
      "provider_fields": [
        "id",
        "user_id",
        "public_id",
        "name",
        "description",
        "avatar_url",
        "rating_history_public"
      ],
      "required_fields": [
        "id",
        "user_id",
        "public_id",
        "name",
        "rating_history_public"
      ],
      "semantic_notes": {
        "user_id": "Server-authoritative immutable owner identity; never browser-authoritative.",
        "public_id": "Stable opaque public profile identifier generated by the server and preserved across owner updates.",
        "rating_history_public": "Private-by-default visibility flag. Application creation supplies 0/false and public rating history is projected only after explicit owner opt-in; connected provider default behavior remains pending a valid authenticated creation fixture."
      }
    },
    "catalogue_source_records": {
      "classification": "UNAVAILABLE",
      "provider_fields": []
    },
    "product_images": {
      "classification": "UNAVAILABLE",
      "provider_fields": []
    },
    "producer_logos": {
      "classification": "UNAVAILABLE",
      "provider_fields": []
    },
    "product_external_ids": {
      "classification": "UNAVAILABLE",
      "provider_fields": []
    },
    "product_image_orphans": {
      "classification": "UNAVAILABLE",
      "provider_fields": []
    },
    "product_image_reconciliation_audit": {
      "classification": "UNAVAILABLE",
      "provider_fields": []
    }
  },
  "external_writers": {
    "pourfolio-feeder": {
      "default_policy": "deny",
      "collections": {
        "products": {
          "operations": [
            "create",
            "update"
          ],
          "required_create_fields": [
            "product_name",
            "producer_id"
          ],
          "writable_fields": [
            "product_name",
            "product_category_id",
            "producer_id",
            "abv",
            "ibu",
            "declared_category",
            "edition",
            "collaboration",
            "product_image"
          ]
        },
        "producers": {
          "operations": [],
          "writable_fields": [],
          "reason": "The evidenced producers collection has no deployed logo field."
        },
        "catalogue_source_records": {
          "operations": [],
          "writable_fields": [],
          "reason": "The collection is not evidenced in the active provider export."
        },
        "product_images": {
          "operations": [],
          "writable_fields": [],
          "reason": "The collection is not evidenced in the active provider export."
        },
        "producer_logos": {
          "operations": [],
          "writable_fields": [],
          "reason": "The collection is not evidenced in the active provider export."
        },
        "product_external_ids": {
          "operations": [],
          "writable_fields": [],
          "reason": "The collection is not evidenced in the active provider export."
        },
        "product_image_orphans": {
          "operations": [],
          "writable_fields": [],
          "reason": "The collection is not evidenced in the active provider export."
        },
        "product_image_reconciliation_audit": {
          "operations": [],
          "writable_fields": [],
          "reason": "The collection is not evidenced in the active provider export."
        },
        "product_producers": {
          "operations": [],
          "writable_fields": [],
          "reason": "The relationship collection is deployed for Pourfolio application-governed catalogue writes. Feeder writes remain denied pending a separately certified ingestion contract."
        },
        "profiles": {
          "operations": [],
          "writable_fields": [],
          "reason": "Profiles are owner-scoped application data. External feeder writes are denied."
        }
      }
    }
  },
  "deferred_targets": {
    "catalogue_moderation": {
      "classification": "DEFERRED_TARGET",
      "target_version": 1,
      "provider_mapping": null,
      "provider_evidence": "NOT_RUN",
      "mutable_enabled": false,
      "entity_types": [
        "product",
        "producer"
      ],
      "identity": {
        "entity_id": "canonical_positive_decimal_string",
        "actor_id": "opaque_verified_session_id",
        "record_ids": "opaque_server_generated_id",
        "versions": "non_negative_safe_integer"
      },
      "verification": {
        "persisted_states": [
          "pending",
          "approved",
          "needs_changes",
          "rejected"
        ],
        "legacy_projection": "unknown",
        "legacy_rule": "missing_pre_activation_record_only",
        "pending_capabilities": [
          "search",
          "view",
          "rate",
          "cellar"
        ],
        "exposure_states": [
          "normal",
          "restricted"
        ],
        "effective_approval": "current_content_and_current_producer_dependencies"
      },
      "records": {
        "entity": {
          "provider_collection": null,
          "logical_fields": [
            "entity_type",
            "entity_id",
            "record_version",
            "content_version",
            "approved_content_version",
            "verification_state",
            "exposure_state",
            "submitter_id",
            "created_at",
            "updated_at",
            "last_decision_id"
          ],
          "unique_keys": [
            [
              "entity_type",
              "entity_id"
            ]
          ]
        },
        "proposal": {
          "provider_collection": null,
          "logical_fields": [
            "proposal_id",
            "entity_type",
            "entity_id",
            "base_content_version",
            "proposed_fields",
            "evidence",
            "submitter_id",
            "submission_key",
            "status",
            "proposal_version",
            "created_at",
            "updated_at"
          ],
          "unique_keys": [
            [
              "proposal_id",
              "proposal_version"
            ],
            [
              "submitter_id",
              "submission_key"
            ]
          ],
          "states": [
            "pending",
            "needs_changes",
            "accepted",
            "rejected",
            "superseded"
          ]
        },
        "decision": {
          "provider_collection": null,
          "logical_fields": [
            "decision_id",
            "operation_id",
            "entity_type",
            "entity_id",
            "action",
            "actor_id",
            "reviewed_record_version",
            "reviewed_content_version",
            "resulting_record_version",
            "resulting_content_version",
            "previous_state",
            "next_state",
            "permitted_diff",
            "dependency_versions",
            "reason",
            "evidence",
            "committed_at"
          ],
          "unique_keys": [
            [
              "decision_id"
            ],
            [
              "operation_id"
            ]
          ]
        },
        "operation": {
          "provider_collection": null,
          "logical_fields": [
            "operation_id",
            "actor_id",
            "idempotency_key",
            "intent_fingerprint",
            "entity_type",
            "entity_id",
            "base_record_version",
            "base_content_version",
            "state",
            "checkpoints",
            "created_at",
            "updated_at",
            "result_reference"
          ],
          "unique_keys": [
            [
              "operation_id"
            ],
            [
              "actor_id",
              "idempotency_key"
            ]
          ],
          "states": [
            "prepared",
            "committing",
            "reconciling",
            "committed",
            "blocked"
          ]
        }
      },
      "versions": {
        "review_requires": [
          "record_version",
          "content_version",
          "producer_dependency_versions",
          "producer_relation_fingerprint"
        ],
        "record_advances": "every_committed_decision",
        "content_advances": "material_content_or_attribution_change",
        "approved_content_matches_current": true
      },
      "verification_transitions": [
        {
          "action": "initialize",
          "actor": "Submitter",
          "from_states": [
            "absent"
          ],
          "to_state": "pending",
          "guards": [
            "current_versions",
            "durable_initialization"
          ]
        },
        {
          "action": "approve",
          "actor": "Admin",
          "from_states": [
            "pending",
            "needs_changes",
            "unknown"
          ],
          "to_state": "approved",
          "guards": [
            "current_versions",
            "producer_dependencies_approved",
            "evidence"
          ]
        },
        {
          "action": "request_changes",
          "actor": "Admin",
          "from_states": [
            "pending"
          ],
          "to_state": "needs_changes",
          "guards": [
            "current_versions",
            "reason"
          ]
        },
        {
          "action": "reject",
          "actor": "Admin",
          "from_states": [
            "pending",
            "needs_changes",
            "unknown"
          ],
          "to_state": "rejected",
          "guards": [
            "current_versions",
            "reason"
          ]
        },
        {
          "action": "resubmit",
          "actor": "Submitter",
          "from_states": [
            "needs_changes",
            "rejected"
          ],
          "to_state": "pending",
          "guards": [
            "current_versions",
            "original_submitter",
            "new_proposal_revision"
          ]
        },
        {
          "action": "apply_correction",
          "actor": "Admin",
          "from_states": [
            "approved"
          ],
          "to_state": "approved",
          "guards": [
            "current_versions",
            "producer_dependencies_approved",
            "evidence",
            "reason",
            "validated_diff"
          ]
        },
        {
          "action": "revoke_verification",
          "actor": "Admin",
          "from_states": [
            "approved"
          ],
          "to_state": "needs_changes",
          "guards": [
            "current_versions",
            "reason"
          ]
        }
      ],
      "exposure": {
        "actions": [
          "restrict",
          "unrestrict"
        ],
        "actor": "Admin",
        "guards": [
          "current_versions",
          "reason"
        ],
        "independent_of_verification": true,
        "resubmission_preserves_restriction": true,
        "restricted_new_activity": "deny",
        "historical_reference": "safe_identity_placeholder"
      },
      "reliability": {
        "required_capabilities": [
          "unique_actor_operation_key",
          "atomic_version_fence",
          "atomic_commit_or_certified_fenced_recovery",
          "all_catalogue_writers_fenced",
          "current_producer_dependency_fence",
          "complete_snapshot_and_isolated_restore",
          "provider_role_write_denial_and_revocation"
        ],
        "same_key_same_intent": "return_original_result",
        "same_key_different_intent": "conflict",
        "unknown_result": "reconcile_original_operation",
        "audit": "append_only_allowlisted_diff"
      },
      "migration": {
        "mode": "additive_only",
        "schema_inventory": "UNVERIFIED",
        "legacy_backfill": "none_without_review",
        "activation": "after_provider_and_all_writer_certification",
        "rollback": "disable_commands_preserve_records",
        "plan": "docs/nocodebackend/moderation-migration-plan.md"
      },
      "editable_fields": {
        "product": [
          "product_name",
          "product_category_id",
          "abv",
          "ibu",
          "declared_category",
          "edition"
        ],
        "producer": [
          "producer_name",
          "address",
          "suburb_id"
        ]
      },
      "producer_relationships": {
        "source_collection": "product_producers",
        "complete_set_required": true,
        "primary_count": 1,
        "sort_order_server_owned": true
      }
    }
  }
}
