# Copy to .env.local for local serverless development. Never commit real values.

# Optional development-only target for plain Vite previews. The browser still
# calls same-origin /api/nocodebackend/*; Vite forwards /api to this Pourfolio
# API host so authentication cookies and server-side policy remain in the path.
# Prefer a trusted Pourfolio Vercel deployment or a local `vercel dev` server.
# Do not point this directly at NoCodeBackend or any credential-bearing upstream.
# POURFOLIO_API_PROXY_TARGET=https://your-pourfolio-preview.example

# Server-only NoCodeBackend values. These names match the Vercel project.
# NOCODEBACKEND_DATA_BASE_URL MUST be the generated NoCodeBackend V2 REST API
# root for the database. Do not use the retired AWS Lambda /read|create|update|delete
# proxy URL here. The server adapter calls /{table} and /{table}/{id} directly
# and authenticates with NOCODEBACKEND_SECRET_KEY as a Bearer token.
NOCODEBACKEND_SECRET_KEY=
NOCODEBACKEND_DATA_BASE_URL=
NOCODEBACKEND_AUTH_BASE_URL=

# Vercel KV / Redis integration values. These names match the current Vercel
# project integration. The application rate limiter uses the REST URL and
# read/write REST token. Do not use the read-only token for rate-limit writes.
pourfolio_KV_REST_API_URL=
pourfolio_KV_REST_API_TOKEN=

# These are also provisioned by the Vercel integration but are not consumed by
# the current @upstash/redis REST client. They remain server-only.
# pourfolio_KV_URL=
# pourfolio_REDIS_URL=
# pourfolio_KV_REST_API_READ_ONLY_TOKEN=

# Compatibility aliases only. They are not required when the Vercel variables
# above are present.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional dedicated override for the opaque rate-limit key. When omitted the
# server derives a domain-separated key from NOCODEBACKEND_SECRET_KEY, so the
# Vercel deployment does not require an additional secret solely for bucketing.
# RATE_LIMIT_KEY_SECRET=

# Optional comma-separated origins permitted to make unsafe cross-origin
# requests. Leave empty for same-origin only.
# ALLOWED_ORIGINS=https://staging.example.com

# Non-destructive connected provider smoke verification. Supply the direct V2
# data base URL and server secret, then run `npm run test:provider-smoke`.
# RUN_NOCODEBACKEND_PROVIDER_SMOKE=1

# Brew Done It is not an approved launch feature. The gateway deliberately
# fails closed unless this server-only flag is exactly "true". Leave it unset
# in normal development, staging and production environments; never expose it
# through a VITE_ variable.
# BREW_DONE_IT_POLICY_ENABLED=false

# Destructive NoCodeBackend provider-contract certification. Configure these
# only in the isolated staging job that runs `npm run test:provider-contract`.
# The suite refuses to start unless the environment and destructive opt-in have
# these exact values. IDs must point to disposable/cleanup-safe staging data.
# RUN_NOCODEBACKEND_PROVIDER_CONTRACT=1
# NCB_CONTRACT_ENVIRONMENT=isolated-staging
# NCB_CONTRACT_ALLOW_DESTRUCTIVE=1
# NCB_CONTRACT_USER_ID=
# NCB_CONTRACT_PRODUCT_ID=
# NCB_CONTRACT_ATTRIBUTE_ID=
# NCB_CONTRACT_TRANSCRIPT_PATH=artifacts/provider-contract/redacted-transcript.json
