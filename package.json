{
  "name": "pourfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "lint:error": "eslint . --quiet",
    "preview": "vite preview",
    "test": "node --test",
    "test:e2e": "playwright test",
    "test:provider-smoke": "RUN_NOCODEBACKEND_PROVIDER_SMOKE=1 node --test api/_lib/__tests__/providerSmoke.connected.test.js",
    "test:provider-contract": "RUN_NOCODEBACKEND_PROVIDER_CONTRACT=1 node --test api/_lib/__tests__/providerContract.connected.test.js",
    "check:provider-contract-transcript": "node scripts/check-provider-contract-transcript.js",
    "check:nocodebackend-env": "node scripts/check-nocodebackend-environment-contract.js",
    "test:release": "playwright test --config=playwright.release.config.js",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "audit:import": "node scripts/audit-import-references.js",
    "audit:import:remediation": "node scripts/audit-reference-remediation.js",
    "audit:import:rehearsal": "node scripts/audit-import-rehearsal.js",
    "audit:catalogue": "node scripts/audit-catalogue-source.js",
    "audit:catalogue:remediation": "node scripts/audit-catalogue-remediation.js",
    "apply:catalogue:remediation": "node scripts/apply-catalogue-remediation.js",
    "audit:baseline": "node scripts/audit-baseline-bundle.js",
    "audit:schema:additive": "node scripts/audit-additive-schema-contract.js",
    "audit:schema": "node scripts/audit-schema-contract.js",
    "audit:rating:migration-evidence": "node scripts/audit-rating-migration-evidence.js",
    "check:bundle": "node scripts/check-bundle-size.js",
    "check:brew-containment": "node scripts/check-brew-done-it-containment.js",
    "check:release-security": "node scripts/check-browser-release-security.js",
    "validate": "npm run check:nocodebackend-env && npm run lint && npm test && npm run audit:production && npm run build && npm run check:bundle && npm run check:brew-containment && npm run check:release-security"
  },
  "dependencies": {
    "@upstash/redis": "^1.38.2",
    "framer-motion": "^13.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.17",
    "vite": "^8.2.0"
  }
}
